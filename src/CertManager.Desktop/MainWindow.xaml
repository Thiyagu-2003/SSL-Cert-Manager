<Window x:Class="CertManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:CertManager.Desktop.Views"
        xmlns:vm="clr-namespace:CertManager.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="CertFlow — Automated SSL/TLS Lifecycle Manager" 
        Icon="Assets/certflow.ico"
        Height="780" Width="1200" MinHeight="650" MinWidth="1000"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="#F8FAFC">

    <Window.Resources>
        <!-- View-ViewModel Implicit DataTemplates -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WebsitesViewModel}">
            <views:WebsitesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CertificatesViewModel}">
            <views:CertificatesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
            <views:ProfilesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AcmeAccountsViewModel}">
            <views:AcmeAccountsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}">
            <views:LogsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TutorialsViewModel}">
            <views:TutorialsView/>
        </DataTemplate>

        <!-- Modern Sidebar Nav Button Style with Dynamic Selection -->
        <Style x:Key="SidebarNavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar Navigation -->
        <Border Grid.Column="0" Background="#0F172A">
            <Grid Margin="18,24,18,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="6,0,6,28">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- CertFlow Cryptographic Orbital Trust Seal Brand Badge (sample_ssl_3_cert_seal) -->
                        <Border CornerRadius="12" Width="44" Height="44" Margin="0,0,12,0" Background="#0B132B" BorderBrush="#1E293B" BorderThickness="1.5">
                            <Viewbox Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="256" Height="256">
                                    <!-- Outer Cryptographic Orbital Ring (Large & Bold) -->
                                    <Ellipse Canvas.Left="28" Canvas.Top="28" Width="200" Height="200" 
                                             Stroke="#0284C7" StrokeThickness="15"/>

                                    <!-- Inner Dashed Verification Ring -->
                                    <Ellipse Canvas.Left="54" Canvas.Top="54" Width="148" Height="148" 
                                             Stroke="#38BDF8" StrokeThickness="7" StrokeDashArray="3,2"/>

                                    <!-- Stamp Core -->
                                    <Ellipse Canvas.Left="76" Canvas.Top="76" Width="104" Height="104" Fill="#2563EB"/>
                                    <Ellipse Canvas.Left="84" Canvas.Top="84" Width="88" Height="88" Fill="#0F172A"/>

                                    <!-- Central High-Visibility TLS Padlock (Crisp White) -->
                                    <Path Data="M 115,108 C 115,100 120,95 128,95 C 136,95 141,100 141,108 L 141,118 L 115,118 Z" 
                                          Stroke="#FFFFFF" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Rectangle Canvas.Left="108" Canvas.Top="118" Width="40" Height="30" RadiusX="7" RadiusY="7" Fill="#FFFFFF"/>
                                    <Ellipse Canvas.Left="124" Canvas.Top="126" Width="8" Height="8" Fill="#0284C7"/>
                                    <Path Data="M 128,133 L 128,140" Stroke="#0284C7" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                    <!-- Orbital Trust Verification Nodes -->
                                    <Ellipse Canvas.Left="118" Canvas.Top="18" Width="20" Height="20" Fill="#22D3EE"/>
                                    <Ellipse Canvas.Left="124" Canvas.Top="24" Width="8" Height="8" Fill="#FFFFFF"/>
                                    <Ellipse Canvas.Left="118" Canvas.Top="218" Width="20" Height="20" Fill="#38BDF8"/>
                                    <Ellipse Canvas.Left="124" Canvas.Top="224" Width="8" Height="8" Fill="#FFFFFF"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CertFlow" Foreground="#FFFFFF" FontSize="19" FontWeight="Bold"/>
                            <TextBlock Text="SSL/TLS Automation" Foreground="#38BDF8" FontSize="11" FontWeight="Medium"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Links -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="MAIN NAVIGATION" Foreground="#64748B" FontSize="11" FontWeight="Bold" Margin="8,0,0,10"/>
                    
                    <!-- Dashboard Nav Button -->
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Dashboard">
                                        <Setter Property="Background" Value="#0284C7"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDashboard}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Text="Dashboard"/>
                        </StackPanel>
                    </Button>

                    <!-- Websites & IIS Nav Button -->
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Websites">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Websites">
                                        <Setter Property="Background" Value="#0284C7"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconGlobe}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Text="Websites &amp; IIS"/>
                        </StackPanel>
                    </Button>

                    <!-- Certificates Nav Button -->
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Certificates">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Certificates">
                                        <Setter Property="Background" Value="#0284C7"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCertificate}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Text="Certificates"/>
                        </StackPanel>
                    </Button>

                    <!-- Certificate Profiles Nav Button -->
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Profiles">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Profiles">
                                        <Setter Property="Background" Value="#0284C7"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconProfiles}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Text="Certificate Profiles"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="SETTINGS &amp; SYSTEM" Foreground="#64748B" FontSize="11" FontWeight="Bold" Margin="8,20,0,10"/>

                    <!-- ACME Accounts Nav Button -->
                    <Button Command="{Binding NavigateCommand}" CommandParameter="AcmeAccounts">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="AcmeAccounts">
                                        <Setter Property="Background" Value="#0284C7"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconKey}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Text="ACME Accounts"/>
                        </StackPanel>
                    </Button>

                    <!-- Notifications & Alerts Nav Button -->
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Notifications">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Notifications">
                                        <Setter Property="Background" Value="#0284C7"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconBell}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Text="Notifications &amp; Alerts"/>
                        </StackPanel>
                    </Button>

                    <!-- Activity Logs Nav Button -->
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Logs">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Logs">
                                        <Setter Property="Background" Value="#0284C7"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLogs}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Text="Activity Logs"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="HELP &amp; GUIDES" Foreground="#64748B" FontSize="11" FontWeight="Bold" Margin="8,20,0,10"/>

                    <!-- Tutorials & Guides Nav Button -->
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Tutorials">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Tutorials">
                                        <Setter Property="Background" Value="#0284C7"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTutorials}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Text="Tutorials &amp; Guides"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Bottom User & Role Indicator -->
                <Border Grid.Row="2" Background="#1E293B" CornerRadius="10" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#334155" CornerRadius="15" Width="30" Height="30" Margin="0,0,10,0">
                            <Path Data="{StaticResource IconUser}" Fill="#94A3B8" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Administrator" Foreground="#FFFFFF" FontSize="12.5" FontWeight="Bold"/>
                            <TextBlock Text="Windows Local Identity" Foreground="#94A3B8" FontSize="11" FontWeight="Medium"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Right Content Host with View DataTemplate Mapping -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>
    </Grid>
</Window>

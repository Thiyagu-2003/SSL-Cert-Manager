<Window x:Class="CertManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:CertManager.Desktop.Views"
        xmlns:vm="clr-namespace:CertManager.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="CertFlow — Automated SSL/TLS Lifecycle Manager" 
        Icon="Assets/certflow.ico"
        Height="780" Width="1200" MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        Background="#F8FAFC">

    <Window.Resources>
        <!-- View-ViewModel Implicit DataTemplates -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WebsitesViewModel}">
            <views:WebsitesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CertificatesViewModel}">
            <views:CertificatesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
            <views:ProfilesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AcmeAccountsViewModel}">
            <views:AcmeAccountsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}">
            <views:LogsView/>
        </DataTemplate>

        <!-- Modern Sidebar Nav Button Style with Dynamic Selection -->
        <Style x:Key="SidebarNavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar Navigation -->
        <Border Grid.Column="0" Background="#0F172A">
            <Grid Margin="18,24,18,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="6,0,6,28">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- CertFlow Cryptographic Orbital Trust Seal Brand Badge (sample_ssl_3_cert_seal) -->
                        <Border CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0" Background="#0B132B" BorderBrush="#1E293B" BorderThickness="1">
                            <Viewbox Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="256" Height="256">
                                    <!-- Outer Cryptographic Orbital Ring -->
                                    <Ellipse Canvas.Left="54" Canvas.Top="54" Width="148" Height="148" 
                                             Stroke="#0284C7" StrokeThickness="12"/>

                                    <!-- Inner Verification Ring -->
                                    <Ellipse Canvas.Left="74" Canvas.Top="74" Width="108" Height="108" 
                                             Stroke="#38BDF8" StrokeThickness="6" StrokeDashArray="3,2"/>

                                    <!-- Stamp Core -->
                                    <Ellipse Canvas.Left="90" Canvas.Top="90" Width="76" Height="76" Fill="#2563EB"/>
                                    <Ellipse Canvas.Left="96" Canvas.Top="96" Width="64" Height="64" Fill="#0F172A"/>

                                    <!-- Central TLS Lock Glyph (Crisp White) -->
                                    <Path Data="M 121,116 C 121,111 124,108 128,108 C 132,108 135,111 135,116 L 135,122 L 121,122 Z" 
                                          Stroke="#FFFFFF" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Rectangle Canvas.Left="115" Canvas.Top="122" Width="26" Height="20" RadiusX="4" RadiusY="4" Fill="#FFFFFF"/>
                                    <Ellipse Canvas.Left="125.5" Canvas.Top="129" Width="5" Height="5" Fill="#0284C7"/>
                                    <Path Data="M 128,132 L 128,137" Stroke="#0284C7" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                    <!-- Orbital Trust Verification Nodes -->
                                    <Ellipse Canvas.Left="121" Canvas.Top="47" Width="14" Height="14" Fill="#22D3EE"/>
                                    <Ellipse Canvas.Left="125" Canvas.Top="51" Width="6" Height="6" Fill="#FFFFFF"/>
                                    <Ellipse Canvas.Left="121" Canvas.Top="195" Width="14" Height="14" Fill="#38BDF8"/>
                                    <Ellipse Canvas.Left="125" Canvas.Top="199" Width="6" Height="6" Fill="#FFFFFF"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CertFlow" Foreground="#FFFFFF" FontSize="19" FontWeight="Bold"/>
                            <TextBlock Text="SSL/TLS Automation" Foreground="#38BDF8" FontSize="11" FontWeight="Medium"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Links -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="MAIN NAVIGATION" Foreground="#475569" FontSize="10" FontWeight="Bold" Margin="8,0,0,10"/>
                    
                    <!-- Dashboard Nav Button -->
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Dashboard">
                                        <Setter Property="Background" Value="#0284C7"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Margin="0,0,10,0"/>
                            <TextBlock Text="Dashboard"/>
                        </StackPanel>
                    </Button>

                    <!-- Websites & IIS Nav Button -->
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Websites">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Websites">
                                        <Setter Property="Background" Value="#0284C7"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐" Margin="0,0,10,0"/>
                            <TextBlock Text="Websites &amp; IIS"/>
                        </StackPanel>
                    </Button>

                    <!-- Certificates Nav Button -->
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Certificates">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Certificates">
                                        <Setter Property="Background" Value="#0284C7"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📜" Margin="0,0,10,0"/>
                            <TextBlock Text="Certificates"/>
                        </StackPanel>
                    </Button>

                    <!-- Certificate Profiles Nav Button -->
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Profiles">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Profiles">
                                        <Setter Property="Background" Value="#0284C7"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📑" Margin="0,0,10,0"/>
                            <TextBlock Text="Certificate Profiles"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="SETTINGS &amp; SYSTEM" Foreground="#475569" FontSize="10" FontWeight="Bold" Margin="8,20,0,10"/>

                    <!-- ACME Accounts Nav Button -->
                    <Button Command="{Binding NavigateCommand}" CommandParameter="AcmeAccounts">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="AcmeAccounts">
                                        <Setter Property="Background" Value="#0284C7"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔐" Margin="0,0,10,0"/>
                            <TextBlock Text="ACME Accounts"/>
                        </StackPanel>
                    </Button>

                    <!-- Activity Logs Nav Button -->
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Logs">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Logs">
                                        <Setter Property="Background" Value="#0284C7"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" Margin="0,0,10,0"/>
                            <TextBlock Text="Activity Logs"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Bottom User & Role Indicator -->
                <Border Grid.Row="2" Background="#1E293B" CornerRadius="10" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#334155" CornerRadius="15" Width="30" Height="30" Margin="0,0,10,0">
                            <TextBlock Text="👤" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Administrator" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="Windows Local Identity" Foreground="#64748B" FontSize="10"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Right Content Host with View DataTemplate Mapping -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>
    </Grid>
</Window>

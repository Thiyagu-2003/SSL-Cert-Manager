<UserControl x:Class="CertManager.Desktop.Views.AcmeAccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="900"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Action Controls -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="ACME Accounts &amp; Authorities" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Certificate Authority registration identities, directory endpoints, and cryptographic keys" 
                           FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding RefreshCommand}" Background="#FFFFFF" BorderBrush="#E2E8F0" 
                        BorderThickness="1" Foreground="#334155" Padding="14,8" Cursor="Hand" Margin="0,0,8,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" Margin="0,0,6,0"/>
                        <TextBlock Text="Refresh Accounts" FontWeight="Medium"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Accounts Content -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Accounts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" 
                                    CornerRadius="10" Padding="18,16" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🔐" FontSize="18" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding DirectoryName}" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" Background="{Binding EnvironmentBadgeBackground}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="{Binding EnvironmentBadgeColor}"/>
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Row="1">
                                        <Grid Margin="0,2,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Directory URI:" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DirectoryUrl}" FontSize="12" FontFamily="Consolas" Foreground="#0284C7"/>
                                        </Grid>

                                        <Grid Margin="0,2,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Contact:" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ContactEmail}" FontSize="12" Foreground="#334155"/>
                                        </Grid>

                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Terms of Service:" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TermsOfService}" FontSize="12" Foreground="#16A34A" FontWeight="Medium"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

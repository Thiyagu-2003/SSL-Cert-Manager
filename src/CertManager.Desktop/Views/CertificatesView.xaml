<UserControl x:Class="CertManager.Desktop.Views.CertificatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style x:Key="CertCardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" Opacity="0.03" ShadowDepth="3" Color="#0F172A"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#0284C7"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                 To="-3" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Page Entrance Animation -->
    <UserControl.RenderTransform>
        <TranslateTransform x:Name="PageTransform" Y="20"/>
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="PageTransform" Storyboard.TargetProperty="Y" From="20" To="0" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,30,36,36">
            <!-- Header -->
            <Grid Margin="0,0,0,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="SSL/TLS Certificate Inventory" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Windows Certificate Store items, 90-day renewal horizon, and automated ACME ARI schedule" 
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleGanttTimelineCommand}" 
                            Style="{StaticResource ModernToolbarRefreshBtn}"
                            Margin="0,0,10,0" ToolTip="Toggle Visual 90-Day Renewal Timeline &amp; ARI Fleet Schedule">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTimeline}" Fill="#0284C7" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="90-Day Gantt Schedule"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ExportVaultBackupCommand}" 
                            Style="{StaticResource ModernToolbarRefreshBtn}"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconShieldCheck}" Fill="#0284C7" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Backup Vault (.vault)"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshCommand}" 
                            Style="{StaticResource ModernToolbarPrimaryBtn}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="Refresh Inventory"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Metrics Strip -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" 
                        CornerRadius="12" Padding="16,14" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL CERTIFICATES" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalCertificates}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" 
                        CornerRadius="12" Padding="16,14" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="OPTIMAL ACTIVE (0-60d)" FontSize="10.5" FontWeight="Bold" Foreground="#10B981"/>
                        <TextBlock Text="{Binding OptimalActiveCount}" FontSize="26" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" 
                        CornerRadius="12" Padding="16,14" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="IN ARI WINDOW (60-76d)" FontSize="10.5" FontWeight="Bold" Foreground="#0284C7"/>
                        <TextBlock Text="{Binding InAriWindowCount}" FontSize="26" FontWeight="Bold" Foreground="#0284C7" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" 
                        CornerRadius="12" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="WARNING / EXPIRED" FontSize="10.5" FontWeight="Bold" Foreground="#EF4444"/>
                        <TextBlock Text="{Binding ExpiringSoonCount}" FontSize="26" FontWeight="Bold" Foreground="#EF4444" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Collapsible Fleet-Wide 90-Day Horizon & ARI Gantt Chart Panel -->
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" 
                    CornerRadius="14" Padding="22" Margin="0,0,0,24"
                    Visibility="{Binding IsGanttTimelineExpanded, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel>
                    <!-- Gantt Chart Header & Legend -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconTimeline}" Fill="#0284C7" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Fleet-Wide 90-Day Renewal Horizon &amp; ACME ARI Schedule" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="Visual lifecycle mapping across standard 90-day validity window with ACME ARI autonomous renewal trigger" 
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="24,3,0,0"/>
                        </StackPanel>

                        <!-- Legend Chips -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#DCFCE7" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                                <TextBlock Text="🟢 Active (0-60d)" FontSize="10.5" FontWeight="Bold" Foreground="#166534"/>
                            </Border>
                            <Border Background="#E0F2FE" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                                <TextBlock Text="🔵 ARI Window (60-76d)" FontSize="10.5" FontWeight="Bold" Foreground="#0369A1"/>
                            </Border>
                            <Border Background="#FEF3C7" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                                <TextBlock Text="🟡 Warning (&lt;14d)" FontSize="10.5" FontWeight="Bold" Foreground="#B45309"/>
                            </Border>
                            <Border Background="#FEE2E2" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="🔴 Critical (&lt;3d)" FontSize="10.5" FontWeight="Bold" Foreground="#DC2626"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Fleet Multi-Track Gantt Bars -->
                    <ItemsControl ItemsSource="{Binding Certificates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Subject & Issuer -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding Subject}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Issuer}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Segmented 90-Day Horizon Bar with Position Marker -->
                                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Multi-Zone Base Track -->
                                        <Grid Grid.Row="0" Height="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="66.7*"/>
                                                <ColumnDefinition Width="17.7*"/>
                                                <ColumnDefinition Width="12.3*"/>
                                                <ColumnDefinition Width="3.3*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#10B981" CornerRadius="5,0,0,5" Opacity="0.85" ToolTip="Optimal Active Window (Days 0-60)"/>
                                            <Border Grid.Column="1" Background="#0284C7" Opacity="0.9" ToolTip="Optimal ACME ARI Renewal Window (Days 60-76)"/>
                                            <Border Grid.Column="2" Background="#F59E0B" Opacity="0.9" ToolTip="Warning Window: Less than 14 Days Remaining (Days 76-87)"/>
                                            <Border Grid.Column="3" Background="#EF4444" CornerRadius="0,5,5,0" Opacity="0.9" ToolTip="Critical Emergency Phase: Less than 3 Days Remaining (Days 87-90)"/>
                                        </Grid>

                                        <!-- Position Progress Bar -->
                                        <ProgressBar Grid.Row="1" Value="{Binding ProgressPercent}" Height="4" Margin="0,2,0,0"
                                                     BorderThickness="0" Background="Transparent" Foreground="#0F172A"/>
                                    </Grid>

                                    <!-- Status Badge -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Border Background="{Binding ZoneBadgeBackground}" CornerRadius="6" Padding="8,3">
                                            <TextBlock Text="{Binding ZoneLabel}" FontSize="10" FontWeight="Bold" Foreground="{Binding ZoneBadgeForeground}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding RemainingDays, StringFormat='⏳ {0}d remaining'}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Status Banner -->
            <Border Background="{DynamicResource MutedBgBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,24">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium"/>
            </Border>

            <!-- Certificates List -->
            <ItemsControl ItemsSource="{Binding Certificates}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CertCardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Details -->
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Health Badge -->
                                        <Border CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsExpiringSoon}" Value="True">
                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                                                <Setter Property="Text" Value="EXPIRED"/>
                                                                <Setter Property="Foreground" Value="#991B1B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsExpiringSoon}" Value="True">
                                                                <Setter Property="Text" Value="RENEWAL DUE"/>
                                                                <Setter Property="Foreground" Value="#92400E"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                        <Setter Property="Text" Value="HEALTHY"/>
                                                        <Setter Property="Foreground" Value="#166534"/>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- ARI Lifecycle Zone Badge -->
                                        <Border Background="{Binding ZoneBadgeBackground}" CornerRadius="6" Padding="8,3" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding ZoneLabel}" FontSize="11" FontWeight="Bold" Foreground="{Binding ZoneBadgeForeground}"/>
                                        </Border>

                                        <TextBlock Text="{Binding Subject}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Thumbprint, Issuer, Remaining Days -->
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,12">
                                        <Border Background="{DynamicResource MutedBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,3" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Thumbprint}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                        <Border Background="{DynamicResource MutedBgBrush}" CornerRadius="6" Padding="6,3" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Issuer}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                        <Border Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="6" Padding="6,3">
                                            <TextBlock Text="{Binding RemainingDays, StringFormat='⏳ {0} days remaining'}" FontSize="11" FontWeight="SemiBold" Foreground="#1E40AF"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- 90-Day Renewal Horizon & ACME ARI Gantt Chart Component -->
                                    <Border Background="{DynamicResource MutedBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" 
                                            CornerRadius="10" Padding="14,10" Margin="0,0,30,0">
                                        <StackPanel>
                                            <!-- Horizon Header -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="90-DAY RENEWAL HORIZON" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding StatusDescription}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <!-- Multi-Zone Colored Horizon Bar -->
                                            <Grid Height="10" Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <!-- Days 0 to 60 (66.7%) Active -->
                                                    <ColumnDefinition Width="66.7*"/>
                                                    <!-- Days 60 to 76 (17.7%) ARI Window -->
                                                    <ColumnDefinition Width="17.7*"/>
                                                    <!-- Days 76 to 87 (12.3%) Warning <14d -->
                                                    <ColumnDefinition Width="12.3*"/>
                                                    <!-- Days 87 to 90 (3.3%) Critical <3d -->
                                                    <ColumnDefinition Width="3.3*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <Border Grid.Column="0" Background="#10B981" CornerRadius="5,0,0,5" Opacity="0.85" ToolTip="Active Lifetime (Days 0-60)"/>
                                                <Border Grid.Column="1" Background="#0284C7" Opacity="0.9" ToolTip="Optimal ACME ARI Renewal Window (Days 60-76)"/>
                                                <Border Grid.Column="2" Background="#F59E0B" Opacity="0.9" ToolTip="Warning Window: &lt;14 Days Remaining (Days 76-87)"/>
                                                <Border Grid.Column="3" Background="#EF4444" CornerRadius="0,5,5,0" Opacity="0.9" ToolTip="Critical Emergency Phase: &lt;3 Days Remaining (Days 87-90)"/>
                                            </Grid>

                                            <!-- Lifetime Spent Progress Indicator -->
                                            <ProgressBar Value="{Binding ProgressPercent}" Height="4" Margin="0,3,0,0"
                                                         BorderThickness="0" Background="Transparent" Foreground="#0284C7"/>

                                            <!-- Timeline Milestone Labels -->
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="66.7*"/>
                                                    <ColumnDefinition Width="17.7*"/>
                                                    <ColumnDefinition Width="12.3*"/>
                                                    <ColumnDefinition Width="3.3*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Grid.Column="0" Text="{Binding NotBefore, StringFormat='Day 0 ({0})'}" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left"/>
                                                <TextBlock Grid.Column="1" Text="Day 60 (ARI)" FontSize="9.5" Foreground="#0284C7" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                                <TextBlock Grid.Column="2" Text="Day 76 (14d)" FontSize="9.5" Foreground="#D97706" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                                <TextBlock Grid.Column="3" Text="{Binding NotAfter, StringFormat='Day 90 ({0})'}" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Right Actions -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Command="{Binding DataContext.ForceRenewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold"
                                            BorderThickness="0" Padding="14,8" Cursor="Hand" Margin="0,0,0,6">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconRefresh}" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Force Immediate Renewal" VerticalAlignment="Center" FontSize="11.5"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Export & Diagnostic Buttons Group -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Command="{Binding DataContext.InspectLiveTlsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="{DynamicResource ButtonSecBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                Foreground="#0284C7" FontWeight="SemiBold" FontSize="11"
                                                Padding="9,5" Cursor="Hand" Margin="0,0,6,0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                            <TextBlock Text="Verify Live TLS"/>
                                        </Button>

                                        <Button Command="{Binding DataContext.BindToRdpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="{DynamicResource ButtonSecBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                Foreground="{DynamicResource ButtonSecFgBrush}" FontWeight="Medium" FontSize="11"
                                                Padding="9,5" Cursor="Hand" Margin="0,0,6,0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                            <TextBlock Text="Bind RDP"/>
                                        </Button>

                                        <Button Command="{Binding DataContext.ExportPfxCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="{DynamicResource ButtonSecBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                Foreground="{DynamicResource ButtonSecFgBrush}" FontWeight="Medium" FontSize="11"
                                                Padding="9,5" Cursor="Hand" Margin="0,0,6,0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                            <TextBlock Text="Export PFX"/>
                                        </Button>

                                        <Button Command="{Binding DataContext.ExportPemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="{DynamicResource ButtonSecBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                Foreground="{DynamicResource ButtonSecFgBrush}" FontWeight="Medium" FontSize="11"
                                                Padding="9,5" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                            <TextBlock Text="Export PEM"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="CertManager.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="950">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Animated Modern Metric Card Style with Hover Lift & Shadow Glow -->
        <Style x:Key="MetricCardBorder" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" Opacity="0.04" ShadowDepth="4" Color="#0F172A"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                 To="-4" Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="Effect.Opacity"
                                                 To="0.12" Duration="0:0:0.25"/>
                                <DoubleAnimation Storyboard.TargetProperty="Effect.BlurRadius"
                                                 To="22" Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="Effect.Opacity"
                                                 To="0.04" Duration="0:0:0.25"/>
                                <DoubleAnimation Storyboard.TargetProperty="Effect.BlurRadius"
                                                 To="14" Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Animated Action Card Style -->
        <Style x:Key="ActionCardBorder" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#0284C7"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                 To="-3" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Primary Button Style -->
        <Style x:Key="PrimaryActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#075985"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="secBorder" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="secBorder" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="secBorder" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Page Entrance Animation -->
    <UserControl.RenderTransform>
        <TranslateTransform x:Name="PageTransform" Y="20"/>
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="PageTransform" Storyboard.TargetProperty="Y" From="20" To="0" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,30,36,36">
            <!-- Top Dashboard Header -->
            <Grid Margin="0,0,0,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Operations Dashboard" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Automated SSL/TLS discovery, Let's Encrypt issuance, and IIS bindings" 
                               FontSize="13" Foreground="#64748B" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Refresh Button & Timestamp -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastRefreshed, StringFormat='Synced: {0}'}" 
                               Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryActionBtn}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↻" FontSize="14" Margin="0,0,6,0" FontWeight="Bold"/>
                            <TextBlock Text="Refresh Status"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Service Status Banner with Glowing Pulse Indicator -->
            <Border CornerRadius="12" Margin="0,0,0,26" Padding="18,14" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsServiceConnected}" Value="True">
                                <Setter Property="Background" Value="#F0FDF4"/>
                                <Setter Property="BorderBrush" Value="#BBF7D0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsServiceConnected}" Value="False">
                                <Setter Property="Background" Value="#FEF2F2"/>
                                <Setter Property="BorderBrush" Value="#FECACA"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Breathing Pulse Beacon -->
                    <Grid Grid.Column="0" Width="22" Height="22" Margin="0,0,12,0" VerticalAlignment="Center">
                        <!-- Ripple Halo -->
                        <Ellipse x:Name="RippleHalo" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsServiceConnected}" Value="True">
                                            <Setter Property="Fill" Value="#86EFAC"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsServiceConnected}" Value="False">
                                            <Setter Property="Fill" Value="#FCA5A5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="0.9" Duration="0:0:1.4"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="0.9" To="1.3" Duration="0:0:1.4"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" From="0.9" To="1.3" Duration="0:0:1.4"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <!-- Solid Center Dot -->
                        <Ellipse Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsServiceConnected}" Value="True">
                                            <Setter Property="Fill" Value="#16A34A"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsServiceConnected}" Value="False">
                                            <Setter Property="Fill" Value="#DC2626"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsServiceConnected}" Value="True">
                                            <Setter Property="Foreground" Value="#166534"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsServiceConnected}" Value="False">
                                            <Setter Property="Foreground" Value="#991B1B"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="Named Pipe: CertManager.Ipc • Renewals run autonomously without UI active" 
                                   FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#E2E8F0" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Version}" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                        </Border>
                        <Border Background="#E2E8F0" CornerRadius="6" Padding="8,4">
                            <TextBlock Text="{Binding Uptime, StringFormat='Uptime: {0}'}" FontSize="11" FontWeight="Medium" Foreground="#334155"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Metrics Cards Grid -->
            <Grid Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: Total Certificates -->
                <Border Grid.Column="0" Style="{StaticResource MetricCardBorder}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="TOTAL CERTS" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock Text="🛡️" HorizontalAlignment="Right" FontSize="18"/>
                        </Grid>
                        <TextBlock Text="{Binding TotalCertificates}" FontSize="34" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Active in Windows Store" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Expiring Soon -->
                <Border Grid.Column="1" Style="{StaticResource MetricCardBorder}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="EXPIRING SOON" FontSize="11" FontWeight="Bold" Foreground="#D97706"/>
                            <TextBlock Text="⚠️" HorizontalAlignment="Right" FontSize="18"/>
                        </Grid>
                        <TextBlock Text="{Binding ExpiringSoonCount}" FontSize="34" FontWeight="Bold" Foreground="#D97706"/>
                        <TextBlock Text="Due within 30 days" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Active Orders -->
                <Border Grid.Column="2" Style="{StaticResource MetricCardBorder}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="ACTIVE ACME ORDERS" FontSize="11" FontWeight="Bold" Foreground="#2563EB"/>
                            <TextBlock Text="🔄" HorizontalAlignment="Right" FontSize="18"/>
                        </Grid>
                        <TextBlock Text="{Binding ActiveOrdersCount}" FontSize="34" FontWeight="Bold" Foreground="#2563EB"/>
                        <TextBlock Text="In-flight challenges" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 4: Automated Policy -->
                <Border Grid.Column="3" Style="{StaticResource MetricCardBorder}" Margin="0">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="RENEWAL POLICY" FontSize="11" FontWeight="Bold" Foreground="#059669"/>
                            <TextBlock Text="⚡" HorizontalAlignment="Right" FontSize="18"/>
                        </Grid>
                        <TextBlock Text="ARI + 33%" FontSize="24" FontWeight="Bold" Foreground="#059669" Margin="0,6,0,0"/>
                        <TextBlock Text="Percentage &amp; ARI window" FontSize="11" Foreground="#94A3B8" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Quick Action Cards Section -->
            <TextBlock Text="Quick Actions &amp; Lifecycle Management" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,16"/>
            
            <Grid Margin="0,0,0,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Action 1 -->
                <Border Grid.Column="0" Style="{StaticResource ActionCardBorder}">
                    <StackPanel>
                        <TextBlock Text="➕ Request Certificate" FontWeight="SemiBold" FontSize="14" Foreground="#0F172A"/>
                        <TextBlock Text="Request a new SSL/TLS certificate via Let's Encrypt using HTTP-01 or DNS-01." 
                                   TextWrapping="Wrap" FontSize="12" Foreground="#64748B" Margin="0,6,0,16"/>
                        <Button Content="New Certificate Wizard" Style="{StaticResource SecondaryActionBtn}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Action 2 -->
                <Border Grid.Column="1" Style="{StaticResource ActionCardBorder}">
                    <StackPanel>
                        <TextBlock Text="🔍 Discover IIS Sites" FontWeight="SemiBold" FontSize="14" Foreground="#0F172A"/>
                        <TextBlock Text="Scan local Microsoft IIS web server for existing sites, hostnames, and HTTPS bindings." 
                                   TextWrapping="Wrap" FontSize="12" Foreground="#64748B" Margin="0,6,0,16"/>
                        <Button Content="Scan IIS Web Server" Style="{StaticResource SecondaryActionBtn}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Action 3 -->
                <Border Grid.Column="2" Style="{StaticResource ActionCardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="📋 Test ACME Staging" FontWeight="SemiBold" FontSize="14" Foreground="#0F172A"/>
                        <TextBlock Text="Validate end-to-end issuance without hitting Let's Encrypt production rate limits." 
                                   TextWrapping="Wrap" FontSize="12" Foreground="#64748B" Margin="0,6,0,16"/>
                        <Button Content="Run Staging Pre-flight" Style="{StaticResource SecondaryActionBtn}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- System Architecture Snapshot -->
            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="System Capabilities &amp; Architecture" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ACME PROTOCOL" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                            <TextBlock Text="RFC 8555 + RFC 8737 (ARI)" FontSize="12" FontWeight="Medium" Foreground="#334155" Margin="0,2,0,0"/>
                            <TextBlock Text="Let's Encrypt Staging / Prod" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="SERVER INTEGRATION" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                            <TextBlock Text="Microsoft IIS (MWA)" FontSize="12" FontWeight="Medium" Foreground="#334155" Margin="0,2,0,0"/>
                            <TextBlock Text="Transactional binding with rollback" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="LOCAL PERSISTENCE" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                            <TextBlock Text="SQLite Database with WAL" FontSize="12" FontWeight="Medium" Foreground="#334155" Margin="0,2,0,0"/>
                            <TextBlock Text="Idempotency locks &amp; audit ledger" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

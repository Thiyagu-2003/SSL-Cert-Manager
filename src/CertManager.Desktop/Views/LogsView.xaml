<UserControl x:Class="CertManager.Desktop.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="950"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <!-- Page Entrance Animation -->
    <UserControl.RenderTransform>
        <TranslateTransform x:Name="PageTransform" Y="15"/>
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="PageTransform" Storyboard.TargetProperty="Y" From="15" To="0" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Action Controls -->
        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Activity Logs &amp; Audit Trail" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Real-time audit log of certificate issuance, Let's Encrypt challenges, renewals, and IIS bindings" 
                           FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Action Toolbar -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Search Box with Watermark -->
                <Grid Width="210" Height="34" Margin="0,0,10,0">
                    <TextBox x:Name="SearchInput" 
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="30,6,10,6" 
                             FontSize="12.5" 
                             VerticalContentAlignment="Center"
                             Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <!-- Search Icon -->
                    <Path Data="{StaticResource IconSearch}" Fill="#94A3B8" Width="13" Height="13" Stretch="Uniform" 
                          HorizontalAlignment="Left" VerticalAlignment="Center" 
                          Margin="12,0,0,0" IsHitTestVisible="False"/>
                    <!-- Placeholder Watermark -->
                    <TextBlock Text="Search logs..." FontSize="12" Foreground="#94A3B8" 
                               HorizontalAlignment="Left" VerticalAlignment="Center" 
                               Margin="32,0,0,0" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Modern Filter Level ComboBox -->
                <ComboBox ItemsSource="{Binding FilterOptions}"
                          SelectedItem="{Binding Filter, Mode=TwoWay}"
                          Style="{StaticResource ModernComboBox}"
                          Width="130" Height="34" Margin="0,0,10,0"/>

                <!-- Modern Refresh Button -->
                <Button Command="{Binding RefreshCommand}" 
                        Style="{StaticResource ModernToolbarRefreshBtn}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconRefresh}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>

                <!-- Modern Logs Folder Button -->
                <Button Command="{Binding OpenLogsFolderCommand}" 
                        Style="{StaticResource ModernToolbarRefreshBtn}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconFolder}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="Logs Folder"/>
                    </StackPanel>
                </Button>

                <!-- Modern Clear Logs Button -->
                <Button Command="{Binding ClearLogsCommand}" 
                        Style="{StaticResource ModernToolbarDangerBtn}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconTrash}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="Clear"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Logs Content Table/List -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20">
            <Grid>
                <!-- Empty State -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Logs.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Path Data="{StaticResource IconLogs}" Fill="#CBD5E1" Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="No Activity Events Recorded" FontSize="16" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center"/>
                    <TextBlock Text="Certificate issuance workflows, Let's Encrypt validations, and background checks will appear here in real time." 
                               FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Items List -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" 
                                        CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Severity Icon -->
                                        <Border Grid.Column="0" Background="{Binding LevelBadgeBackground}" 
                                                CornerRadius="20" Width="38" Height="38" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <Path Width="18" Height="18" Stretch="Uniform" Fill="{Binding LevelBadgeColor}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Data" Value="{StaticResource IconInfo}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NormalizedLevel}" Value="Error">
                                                                <Setter Property="Data" Value="{StaticResource IconError}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NormalizedLevel}" Value="Warning">
                                                                <Setter Property="Data" Value="{StaticResource IconWarning}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Border>

                                        <!-- Message Content -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Subject}" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,10,0"/>
                                                <Border Background="{Binding LevelBadgeBackground}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Level}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding LevelBadgeColor}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBox Text="{Binding Body, Mode=OneWay}" 
                                                     FontSize="12" Foreground="#475569" TextWrapping="Wrap" 
                                                     IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"/>
                                        </StackPanel>

                                        <!-- Timestamp & Channel -->
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SentAtLocal}" FontSize="11.5" FontWeight="Medium" Foreground="#64748B" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding Channel, StringFormat='via {0}'}" FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="CertManager.Desktop.Views.TutorialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1000">

    <UserControl.Resources>
        <!-- Pill button style -->
        <Style x:Key="GuideTabBtn" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" Opacity="0.04" ShadowDepth="1" Color="#0F172A"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.92"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0284C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Style -->
        <Style x:Key="GuideCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" Opacity="0.04" ShadowDepth="3" Color="#0F172A"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepNumberBadge" TargetType="Border">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,30,36,36">
            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconTutorials}" Fill="#0284C7" Width="24" Height="24" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Tutorials &amp; Step-by-Step Guides" FontSize="26" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Comprehensive guides to issue SSL certificates, configure IIS bindings, and automate lifecycle management" 
                               FontSize="13.5" Foreground="#64748B" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Guide Category Tabs (Responsive WrapPanel: Clean & Modern, No Truncation, No Horizontal Slider) -->
            <WrapPanel Margin="0,0,0,20">
                <!-- Tab 1: Live Domain -->
                <Button Command="{Binding SelectGuideCommand}" CommandParameter="PublicDomain">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GuideTabBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedGuideKey}" Value="PublicDomain">
                                    <Setter Property="Background" Value="#0284C7"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#0284C7"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconGlobe}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Live IIS Hosted Site (HTTP-01)" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Tab 2: Local / Self-Signed -->
                <Button Command="{Binding SelectGuideCommand}" CommandParameter="SelfSigned">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GuideTabBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedGuideKey}" Value="SelfSigned">
                                    <Setter Property="Background" Value="#0284C7"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#0284C7"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconBolt}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Local / Self-Signed Testing" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Tab 3: Wildcards -->
                <Button Command="{Binding SelectGuideCommand}" CommandParameter="Wildcard">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GuideTabBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedGuideKey}" Value="Wildcard">
                                    <Setter Property="Background" Value="#0284C7"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#0284C7"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconShieldCheck}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Wildcard (*.domain.com) DNS-01" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Tab 4: 24/7 Windows Service -->
                <Button Command="{Binding SelectGuideCommand}" CommandParameter="AutoRenewal">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GuideTabBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedGuideKey}" Value="AutoRenewal">
                                    <Setter Property="Background" Value="#0284C7"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#0284C7"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconRefresh}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="24/7 Background Service" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Tab 5: Troubleshooting -->
                <Button Command="{Binding SelectGuideCommand}" CommandParameter="Troubleshooting">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GuideTabBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedGuideKey}" Value="Troubleshooting">
                                    <Setter Property="Background" Value="#0284C7"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#0284C7"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconSearch}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Troubleshooting &amp; Firewall" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>

            <!-- ============================================================ -->
            <!-- GUIDE 1: LIVE HOSTED SITE (HTTP-01)                           -->
            <!-- ============================================================ -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGuideKey}" Value="PublicDomain">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- Overview Card -->
                <Border Style="{StaticResource GuideCard}" Background="#F0F9FF" BorderBrush="#BAE6FD">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource IconGlobe}" Fill="#0284C7" Width="36" Height="36" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,18,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Guide: Get SSL for a Live Hosted Site &amp; Domain (Let's Encrypt)" FontSize="18" FontWeight="Bold" Foreground="#0369A1"/>
                            <TextBlock Text="Use this method to automatically issue a free, globally-trusted Let's Encrypt certificate for your IIS website using HTTP-01 validation." FontSize="13" Foreground="#0284C7" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding NavigateToWebsitesCommand}" 
                                Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,10"
                                BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Go to Websites &amp; IIS" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <Path Data="{StaticResource IconArrowRight}" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Prerequisites Card -->
                <Border Style="{StaticResource GuideCard}">
                    <StackPanel>
                        <TextBlock Text="PREREQUISITES" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconCheckCircle}" Fill="#16A34A" Width="14" Height="14" Stretch="Uniform" Margin="0,2,10,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Text="Public DNS Record: Your domain (e.g. app.example.com) must point (DNS A Record) to this server's public IP address." FontSize="13" Foreground="#334155"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconCheckCircle}" Fill="#16A34A" Width="14" Height="14" Stretch="Uniform" Margin="0,2,10,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Text="Port 80 (HTTP) Open: Let's Encrypt servers must be able to reach your site over Port 80 to verify domain ownership via HTTP-01." FontSize="13" Foreground="#334155"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconCheckCircle}" Fill="#16A34A" Width="14" Height="14" Stretch="Uniform" Margin="0,2,10,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Text="IIS Website Configured: The site must be added in Microsoft IIS Manager with a Port 80 HTTP binding." FontSize="13" Foreground="#334155"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Steps Card -->
                <Border Style="{StaticResource GuideCard}">
                    <StackPanel>
                        <TextBlock Text="STEP-BY-STEP INSTRUCTIONS" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,20"/>

                        <!-- Step 1 -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource StepNumberBadge}">
                                <TextBlock Text="1" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Open the Websites &amp; IIS Scanner" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Click the 'Websites &amp; IIS' menu in the left navigation sidebar. CertFlow will automatically inspect Microsoft IIS on this machine and list all your configured websites, hostnames, and current bindings." 
                                           FontSize="13" Foreground="#475569" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <!-- Step 2 -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource StepNumberBadge}">
                                <TextBlock Text="2" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Click 'Request Certificate' on Your Target Site" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Locate your website row in the inventory table and click the 'Request Certificate' button on the right. This opens the Certificate Wizard pre-populated with your site details." 
                                           FontSize="13" Foreground="#475569" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <!-- Step 3 -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource StepNumberBadge}">
                                <TextBlock Text="3" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Configure Domain &amp; Certificate Authority" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="In the Wizard dialog:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,4,0,4"/>
                                <TextBlock Text="• Domain Identifier: Enter your public domain (e.g. app.mycompany.com). You can also provide multiple SAN domains separated by commas (e.g. mycompany.com, www.mycompany.com)." FontSize="12.5" Foreground="#475569" Margin="10,0,0,3"/>
                                <TextBlock Text="• Contact Email: Provide your email address for Let's Encrypt account registration and expiry notices." FontSize="12.5" Foreground="#475569" Margin="10,0,0,3"/>
                                <TextBlock Text="• Certificate Authority: Select 'Let's Encrypt Production' (for live official certificates) or 'Let's Encrypt Staging' (if testing)." FontSize="12.5" Foreground="#475569" Margin="10,0,0,3"/>
                                <TextBlock Text="• Validation Method: Choose 'HTTP-01 Validation (Local IIS Web Server)'." FontSize="12.5" Foreground="#475569" Margin="10,0,0,3"/>
                            </StackPanel>
                        </Grid>

                        <!-- Step 4 -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource StepNumberBadge}">
                                <TextBlock Text="4" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Click 'Issue Certificate &amp; Bind to IIS'" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="CertFlow handles the entire end-to-end process automatically:" FontSize="13" Foreground="#475569" Margin="0,4,0,4"/>
                                <TextBlock Text="1. Creates the ACME order with Let's Encrypt." FontSize="12.5" Foreground="#475569" Margin="10,0,0,2"/>
                                <TextBlock Text="2. Writes the verification token into .well-known/acme-challenge/ in your site root." FontSize="12.5" Foreground="#475569" Margin="10,0,0,2"/>
                                <TextBlock Text="3. Triggers and polls validation until verified." FontSize="12.5" Foreground="#475569" Margin="10,0,0,2"/>
                                <TextBlock Text="4. Finalizes the RSA 2048 key and downloads the signed certificate." FontSize="12.5" Foreground="#475569" Margin="10,0,0,2"/>
                                <TextBlock Text="5. Installs the certificate into the Windows Certificate Store (LocalMachine\My)." FontSize="12.5" Foreground="#475569" Margin="10,0,0,2"/>
                                <TextBlock Text="6. Creates or updates the Port 443 HTTPS binding with Server Name Indication (SNI) enabled in IIS." FontSize="12.5" Foreground="#475569" Margin="10,0,0,2"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================================================ -->
            <!-- GUIDE 2: LOCAL / SELF-SIGNED TESTING                          -->
            <!-- ============================================================ -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGuideKey}" Value="SelfSigned">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- Overview Card -->
                <Border Style="{StaticResource GuideCard}" Background="#F0FDF4" BorderBrush="#BBF7D0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource IconBolt}" Fill="#15803D" Width="36" Height="36" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,18,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Guide: Fast Local &amp; Development Testing (Self-Signed)" FontSize="18" FontWeight="Bold" Foreground="#15803D"/>
                            <TextBlock Text="Instant HTTPS for development, QA, and staging servers without requiring a public domain, external DNS, or open internet ports." FontSize="13" Foreground="#16A34A" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding LaunchWizardCommand}" CommandParameter="SelfSigned"
                                Background="#16A34A" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,10"
                                BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconBolt}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Open Self-Signed Wizard" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Steps Card -->
                <Border Style="{StaticResource GuideCard}">
                    <StackPanel>
                        <TextBlock Text="HOW TO ISSUE A LOCAL CERTIFICATE" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,20"/>

                        <!-- Step 1 -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource StepNumberBadge}" Background="#16A34A">
                                <TextBlock Text="1" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Launch the Certificate Wizard" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Click the 'Open Self-Signed Wizard' button above, or select your website in 'Websites &amp; IIS' and click 'Request Certificate'." FontSize="13" Foreground="#475569" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Step 2 -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource StepNumberBadge}" Background="#16A34A">
                                <TextBlock Text="2" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Select 'Self-Signed / Local Development Certificate'" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Under 'CERTIFICATE AUTHORITY &amp; ISSUANCE TYPE', select the third option: 'Self-Signed / Local Development Certificate (Instant local IIS testing)'." FontSize="13" Foreground="#475569" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Step 3 -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource StepNumberBadge}" Background="#16A34A">
                                <TextBlock Text="3" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Click 'Issue Certificate'" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="CertFlow generates an RSA 2048 certificate with Server Authentication enhanced key usage, installs it into Windows LocalMachine\My, and creates the HTTPS binding on your IIS site in under 1 second!" FontSize="13" Foreground="#475569" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================================================ -->
            <!-- GUIDE 3: WILDCARDS WITH CLOUDFLARE DNS                        -->
            <!-- ============================================================ -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGuideKey}" Value="Wildcard">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- Overview Card -->
                <Border Style="{StaticResource GuideCard}" Background="#FAF5FF" BorderBrush="#E9D5FF">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource IconShieldCheck}" Fill="#7E22CE" Width="36" Height="36" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,18,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Guide: Wildcard SSL Certificates (*.domain.com)" FontSize="18" FontWeight="Bold" Foreground="#7E22CE"/>
                            <TextBlock Text="Secure unlimited subdomains with a single wildcard certificate using automated DNS-01 challenge verification via Cloudflare API." FontSize="13" Foreground="#9333EA" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Steps Card -->
                <Border Style="{StaticResource GuideCard}">
                    <StackPanel>
                        <TextBlock Text="WILDCARD ISSUANCE STEPS" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,20"/>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource StepNumberBadge}" Background="#9333EA">
                                <TextBlock Text="1" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Get a Cloudflare API Token" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="In your Cloudflare dashboard (My Profile -> API Tokens -> Create Token), create an API token with 'Zone:DNS:Edit' and 'Zone:Zone:Read' permissions." FontSize="13" Foreground="#475569" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource StepNumberBadge}" Background="#9333EA">
                                <TextBlock Text="2" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Enter Domain with Wildcard Prefix" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="In CertFlow's Wizard, type your domain starting with wildcard syntax: *.yourdomain.com. CertFlow automatically switches to DNS-01 validation mode." FontSize="13" Foreground="#475569" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource StepNumberBadge}" Background="#9333EA">
                                <TextBlock Text="3" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Paste Cloudflare API Token &amp; Issue" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Paste your token into the 'CLOUDFLARE API TOKEN' field and click 'Issue Certificate'. CertFlow will create the _acme-challenge TXT record, verify DNS-over-HTTPS propagation, finalize the certificate, and safely clean up the temporary TXT record." FontSize="13" Foreground="#475569" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================================================ -->
            <!-- GUIDE 4: 24/7 WINDOWS SERVICE AUTO-RENEWAL                    -->
            <!-- ============================================================ -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGuideKey}" Value="AutoRenewal">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- Overview Card -->
                <Border Style="{StaticResource GuideCard}" Background="#FFFBEB" BorderBrush="#FDE68A">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource IconRefresh}" Fill="#B45309" Width="36" Height="36" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,18,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Guide: 24/7 Background Service for Autonomous Renewal" FontSize="18" FontWeight="Bold" Foreground="#B45309"/>
                            <TextBlock Text="Keep certificates renewed 24/7 with zero downtime even when no administrator is logged into the Windows Server." FontSize="13" Foreground="#D97706" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding CopyServiceInstallCommand}" 
                                Background="#D97706" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,10"
                                BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconCopy}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Copy Install Command" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Copy Feedback Toast -->
                <TextBlock Text="{Binding CopyNotification}" Foreground="#16A34A" FontWeight="Bold" Margin="0,0,0,10"
                           Visibility="{Binding HasCopyNotification, Converter={StaticResource BoolToVisConverter}}"/>

                <!-- Service Instructions Card -->
                <Border Style="{StaticResource GuideCard}">
                    <StackPanel>
                        <TextBlock Text="SERVICE INSTALLATION COMMANDS" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,16"/>

                        <TextBlock Text="Open PowerShell or Command Prompt as Administrator:" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,8"/>
                        
                        <Border Background="#0F172A" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <TextBlock Text=".\CertFlow.exe --install-service" FontFamily="Consolas, monospace" FontSize="14" Foreground="#38BDF8"/>
                        </Border>

                        <TextBlock Text="What the Service Does:" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,8,0,8"/>
                        <TextBlock Text="• Evaluates certificates continuously against ACME Renewal Information (RFC 8737 ARI) and dynamic 33% lifetime thresholds." FontSize="12.5" Foreground="#475569" Margin="10,0,0,4"/>
                        <TextBlock Text="• Automatically initiates renewals before expiration." FontSize="12.5" Foreground="#475569" Margin="10,0,0,4"/>
                        <TextBlock Text="• Updates IIS bindings atomically with zero website downtime." FontSize="12.5" Foreground="#475569" Margin="10,0,0,4"/>
                        <TextBlock Text="• To remove the service anytime: .\CertFlow.exe --uninstall-service" FontSize="12.5" Foreground="#475569" Margin="10,0,0,4"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================================================ -->
            <!-- GUIDE 5: TROUBLESHOOTING & FIREWALL CHECKLIST                 -->
            <!-- ============================================================ -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGuideKey}" Value="Troubleshooting">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- Overview Card -->
                <Border Style="{StaticResource GuideCard}" Background="#FEF2F2" BorderBrush="#FECACA">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="#B91C1C" Width="36" Height="36" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,18,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Troubleshooting &amp; Pre-Flight Checklist" FontSize="18" FontWeight="Bold" Foreground="#B91C1C"/>
                            <TextBlock Text="Common reasons why Let's Encrypt validation fails and how to resolve them quickly." FontSize="13" Foreground="#DC2626" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Checklist Card -->
                <Border Style="{StaticResource GuideCard}">
                    <StackPanel>
                        <TextBlock Text="COMMON ISSUES &amp; SOLUTIONS" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,16"/>

                        <!-- Issue 1 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconClose}" Fill="#B91C1C" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="1. 'Connection refused' or 'Timeout during connect'" FontWeight="Bold" Foreground="#B91C1C" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Cause: Let's Encrypt cannot reach Port 80 on your server." FontSize="12.5" Foreground="#475569" Margin="0,4,0,2"/>
                                <TextBlock Text="Fix: Check your Windows Firewall and Cloud Security Group (AWS Security Group, Azure NSG, router port forwarding). Ensure Port 80 (HTTP) is allowed from 0.0.0.0/0." FontSize="12.5" Foreground="#0F172A"/>
                            </StackPanel>
                        </Border>

                        <!-- Issue 2 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconClose}" Fill="#B91C1C" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="2. 'No such host is known' or DNS lookup failure" FontWeight="Bold" Foreground="#B91C1C" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Cause: The domain name does not exist or has not propagated." FontSize="12.5" Foreground="#475569" Margin="0,4,0,2"/>
                                <TextBlock Text="Fix: Add an 'A' Record in your DNS provider pointing to your server's public IP address. Wait 5-10 minutes for DNS propagation." FontSize="12.5" Foreground="#0F172A"/>
                            </StackPanel>
                        </Border>

                        <!-- Issue 3 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconClose}" Fill="#B91C1C" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="3. Testing on Localhost or Private IP (192.168.x.x, 10.x.x.x)" FontWeight="Bold" Foreground="#B91C1C" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Cause: Public CAs like Let's Encrypt cannot validate local/private IP addresses or .local domains." FontSize="12.5" Foreground="#475569" Margin="0,4,0,2"/>
                                <TextBlock Text="Fix: In CertFlow's Wizard, select 'Self-Signed / Local Development Certificate'. This issues a valid local SSL certificate and binds it to IIS without requiring public validation." FontSize="12.5" Foreground="#0F172A"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

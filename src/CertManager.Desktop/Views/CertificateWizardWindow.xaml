<Window x:Class="CertManager.Desktop.Views.CertificateWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Request Certificate — CertFlow" 
        Icon="../Assets/certflow.ico"
        Height="660" Width="600" MinHeight="580" MinWidth="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        Background="#F8FAFC">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <Style x:Key="FormFormFieldLabel" BasedOn="{StaticResource FormFieldLabel}" TargetType="TextBlock"/>
    </Window.Resources>

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0284C7" CornerRadius="10" Width="42" Height="42" Margin="0,0,14,0">
                <Path Data="{StaticResource IconShieldCheck}" Fill="#FFFFFF" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Automated Certificate Wizard" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Let's Encrypt ACME issuance with IIS binding &amp; rollback protection" 
                           FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Body Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Target Site Info Banner -->
                <Border Background="#F1F5F9" CornerRadius="10" Padding="14,10" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Target IIS Website" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock Text="{Binding SiteName}" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#E2E8F0" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SiteId, StringFormat='Site ID: {0}'}" FontSize="11" FontWeight="Medium" Foreground="#475569"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Field 1: Domain Name -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="DOMAIN IDENTIFIER" Style="{StaticResource FormFormFieldLabel}" Margin="0"/>
                    <Button Grid.Column="1" Command="{Binding TestReadinessCommand}" 
                            Padding="8,3" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
                            Foreground="#0284C7" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSearch}" Fill="#0284C7" Width="10" Height="10" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Test Readiness (Port 80 &amp; DNS)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBox Text="{Binding DomainName, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>

                <!-- Pre-flight Readiness Diagnostic Result Card -->
                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasReadinessResult}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource IconBolt}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="#16A34A"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ReadinessResult.OverallReady}" Value="False">
                                                <Setter Property="Fill" Value="#D97706"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="PRE-FLIGHT READINESS REPORT" FontSize="11" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- DNS & IP Check -->
                        <TextBlock Text="{Binding ReadinessResult.DnsStatusMessage, StringFormat='• DNS: {0}'}" FontSize="11.5" Foreground="#475569" Margin="0,0,0,4"/>
                        <!-- Port 80 & Firewall Check -->
                        <TextBlock Text="{Binding ReadinessResult.Port80StatusMessage, StringFormat='• Port 80: {0}'}" FontSize="11.5" Foreground="#475569" Margin="0,0,0,4"/>
                        <!-- Challenge Endpoint Check -->
                        <TextBlock Text="{Binding ReadinessResult.ChallengeStatusMessage, StringFormat='• Challenge: {0}'}" FontSize="11.5" Foreground="#475569" Margin="0,0,0,4"/>

                        <!-- Recommendations list -->
                        <ItemsControl ItemsSource="{Binding ReadinessResult.Recommendations}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='💡 {0}'}" FontSize="11" Foreground="#0284C7" Margin="0,2,0,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Global ACME Contact Identity (Managed Globally) -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="GLOBAL CONTACT IDENTITY" FontSize="10.5" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock Text="{Binding ContactEmail}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,2,0,0"/>
                            <TextBlock Text="Applied automatically from global settings across all websites" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding ChangeGlobalEmailCommand}" Content="Change" 
                                VerticalAlignment="Center" Padding="10,5" Background="#FFFFFF" BorderBrush="#CBD5E1" 
                                BorderThickness="1" Foreground="#0284C7" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <!-- Field 3: Certificate Authority & Multi-CA Fallback -->
                <TextBlock Text="CERTIFICATE AUTHORITY &amp; MULTI-CA ENGINE" Style="{StaticResource FormFieldLabel}"/>
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,18">
                    <StackPanel>
                        <!-- CA Selection Row -->
                        <TextBlock Text="Primary Certificate Authority (Instant Switcher)" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding CertificateAuthorities}"
                                  SelectedItem="{Binding SelectedCertificateAuthority, Mode=TwoWay}"
                                  Style="{StaticResource ModernComboBox}"
                                  Height="36" Margin="0,0,0,10"/>

                        <!-- Custom CA URL Box if Custom CA Selected -->
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCustomCa}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="Custom RFC 8555 Directory URL" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding CustomCaDirectoryUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Border>

                        <!-- Multi-CA Auto Fallback Option -->
                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Content="Enable Multi-CA Auto-Fallback on Rate Limit or Downtime"
                                      IsChecked="{Binding EnableCaFallback}"
                                      FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Cursor="Hand"/>
                            <Border Grid.Column="1" Background="#ECFDF5" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="High Availability" FontSize="10" FontWeight="Bold" Foreground="#059669"/>
                            </Border>
                        </Grid>

                        <!-- Secondary Fallback CA Selector (Visible when fallback is enabled) -->
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EnableCaFallback}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="Automatic Failover Authority (if primary hits rate limits):" FontSize="11" FontWeight="SemiBold" Foreground="#166534" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding FallbackCertificateAuthorities}"
                                          SelectedItem="{Binding SelectedFallbackCa, Mode=TwoWay}"
                                          Style="{StaticResource ModernComboBox}"
                                          Height="34"/>
                            </StackPanel>
                        </Border>

                        <!-- Staging Sandbox Mode Checkbox -->
                        <CheckBox Content="Use ACME Staging Environment (Recommended for tests — safe rate limits)" 
                                  IsChecked="{Binding IsStaging}" FontWeight="Medium" Foreground="#475569" Margin="0,2,0,0" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- Field 3b: Modern Cryptography & Store Pruning -->
                <TextBlock Text="CRYPTOGRAPHY &amp; STORE HYGIENE" Style="{StaticResource FormFieldLabel}"/>
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Key Algorithm (Elliptic Curves &amp; Modern RSA)" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding KeyAlgorithms}"
                                  SelectedItem="{Binding SelectedKeyAlgorithm, Mode=TwoWay}"
                                  Style="{StaticResource ModernComboBox}"
                                  Height="36" Margin="0,0,0,6"/>
                        <TextBlock Text="⚡ ECDSA (P-256) delivers 10x faster TLS handshakes, smaller certificates, and maximum security." 
                                   FontSize="10.5" Foreground="#64748B" Margin="0,0,0,10"/>

                        <!-- Store Pruning Toggle -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <CheckBox Content="Auto-Prune Expired &amp; Superseded Certificates" 
                                              IsChecked="{Binding AutoPruneSupersededCerts}"
                                              FontWeight="SemiBold" Foreground="#0F172A" Cursor="Hand"/>
                                    <TextBlock Text="Removes older superseded certificates from LocalMachine\My to prevent certificate store bloat." 
                                               FontSize="10.5" Foreground="#64748B" Margin="20,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#EFF6FF" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="Clean Store" FontSize="10" FontWeight="Bold" Foreground="#0284C7"/>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Field 4: Validation Method Selection -->
                <TextBlock Text="ACME VALIDATION METHOD &amp; WILDCARDS" Style="{StaticResource FormFieldLabel}"/>
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,18">
                    <StackPanel>
                        <RadioButton Content="HTTP-01 Validation (Local IIS Web Server)" 
                                     GroupName="ValidationMethod"
                                     IsChecked="{Binding IsHttp01}" FontWeight="Medium" Foreground="#1E293B" Margin="0,0,0,8" Cursor="Hand"/>
                        <RadioButton Content="DNS-01 Validation (Required for Wildcards *.domain.com)" 
                                     GroupName="ValidationMethod"
                                     IsChecked="{Binding IsDns01}" FontWeight="Medium" Foreground="#1E293B" Cursor="Hand"/>

                        <!-- DNS-01 Configuration Panel (Visible when IsDns01 is True) -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDns01}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="DNS PROVIDER &amp; AUTHENTICATION" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,8"/>
                                
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Grid.Column="0" GroupName="DnsProviderType" Content="Cloudflare API" IsChecked="{Binding IsCloudflareDns}" FontWeight="SemiBold" Foreground="#0284C7"/>
                                    <RadioButton Grid.Column="1" GroupName="DnsProviderType" Content="Manual DNS" IsChecked="{Binding IsManualDns}" FontWeight="Medium" Foreground="#64748B"/>
                                </Grid>

                                <TextBlock Text="Cloudflare API Token (Requires Zone:DNS:Edit)" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,4,0,4"/>
                                <TextBox Text="{Binding DnsApiToken, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,6"/>
                                <TextBlock Text="Token is used only in-memory to create and delete the temporary _acme-challenge TXT record." 
                                           FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Execution Progress / Status Box -->
                <!-- Loading State -->
                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,18">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExecuting}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentStep}" FontWeight="Bold" FontSize="13" Foreground="#1D4ED8"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#3B82F6" Margin="0,4,0,12"/>
                        <ProgressBar IsIndeterminate="True" Height="6" BorderThickness="0" Background="#DBEAFE" Foreground="#2563EB"/>
                    </StackPanel>
                </Border>

                <!-- Success State Card -->
                <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,18">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource IconCheckCircle}" Fill="#16A34A" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Certificate Issued &amp; Bound Successfully!" FontWeight="Bold" FontSize="14" Foreground="#166534" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#15803D" Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Thumbprint:" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding IssuedThumbprint}" FontSize="11" FontFamily="Consolas" FontWeight="Medium" Foreground="#0F172A"/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Valid Until:" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding IssuedExpiration}" FontSize="11" Foreground="#0F172A"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Error State Banner -->
                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,18">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Issuance Failed" FontWeight="Bold" FontSize="13" Foreground="#991B1B"/>
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Content="Close" Click="Close_Click"
                        Background="#F1F5F9" Foreground="#334155" FontWeight="SemiBold" 
                        BorderThickness="0" Padding="16,9" Margin="0,0,10,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="2" 
                        Command="{Binding StartIssuanceCommand}"
                        Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" 
                        BorderThickness="0" Padding="18,9" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconBolt}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Start Automated Issuance" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
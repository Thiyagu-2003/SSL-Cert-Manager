<UserControl x:Class="CertManager.Desktop.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="1100" d:DesignWidth="950"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <!-- Page Entrance Animation -->
    <UserControl.RenderTransform>
        <TranslateTransform x:Name="PageTransform" Y="15"/>
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="PageTransform" Storyboard.TargetProperty="Y" From="15" To="0" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="#E0F2FE" CornerRadius="6" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="ALERTS &amp; WEBHOOKS" FontSize="10" FontWeight="Bold" Foreground="#0284C7"/>
                        </Border>
                        <TextBlock Text="Notifications &amp; Team Alerts" FontSize="22" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Configure real-time alerts for certificate expirations, autonomous renewals, and errors across Teams, Discord, Slack, Telegram, Push, and Email." 
                               FontSize="12.5" Foreground="#64748B"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource ModernToolbarRefreshBtn}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Reload"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveSettingsCommand}" Style="{StaticResource ModernPrimaryActionBtn}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSave}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Save Alert Settings"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Feedback / Toast Banner -->
            <Border Grid.Row="1" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasToastMessage}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource IconCheckCircle}" Fill="#059669" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding ToastMessage}" Foreground="#065F46" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Test Feedback Alert -->
            <Border Grid.Row="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasTestStatus}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource IconInfo}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Fill" Value="#0284C7"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TestStatusIsError}" Value="True">
                                        <Setter Property="Fill" Value="#EF4444"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <TextBlock Grid.Column="1" Text="{Binding TestStatusMessage}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#1E40AF"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TestStatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="#B91C1C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Main Content Container -->
            <StackPanel Grid.Row="2">

                <!-- SECTION 1: Event Lifecycle Subscriptions & Thresholds -->
                <TextBlock Text="ALERT EVENT SUBSCRIPTIONS &amp; EXPIRY POLICIES" Style="{StaticResource FormFieldLabel}"/>
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <CheckBox Content="Certificate Expiration Warning" IsChecked="{Binding NotifyOnExpiryWarning}" FontWeight="SemiBold" Foreground="#0F172A" Cursor="Hand"/>
                                <TextBlock Text="Automated background service scans all active certificates every 60 seconds and notifies when expiration is within the threshold." 
                                           FontSize="11" Foreground="#64748B" Margin="22,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Alert when within:" FontSize="11" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding AvailableExpiryDays}" SelectedItem="{Binding ExpiryWarningDays}" 
                                          Style="{StaticResource ModernComboBox}" Width="80" Height="30"/>
                                <TextBlock Text="days" FontSize="11" Foreground="#475569" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="#F1F5F9" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <CheckBox Content="Autonomous Renewal Succeeded" IsChecked="{Binding NotifyOnRenewalSuccess}" FontWeight="SemiBold" Foreground="#0F172A" Cursor="Hand"/>
                                <TextBlock Text="Delivers green success card with new thumbprint and validity period." FontSize="11" Foreground="#64748B" Margin="22,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <CheckBox Content="Autonomous Renewal Failed" IsChecked="{Binding NotifyOnRenewalFailure}" FontWeight="SemiBold" Foreground="#DC2626" Cursor="Hand"/>
                                <TextBlock Text="High-priority alert sent immediately if renewal encounters rate limits or DNS failure." FontSize="11" Foreground="#64748B" Margin="22,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,2,0,0">
                            <CheckBox Content="Manual / Interactive Issuance Completed" IsChecked="{Binding NotifyOnManualIssuance}" FontWeight="SemiBold" Foreground="#0F172A" Cursor="Hand"/>
                            <TextBlock Text="Sends a notification when an administrator requests a certificate from the Wizard." FontSize="11" Foreground="#64748B" Margin="22,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SECTION 2: Collaboration & Team Chat Channels -->
                <TextBlock Text="COLLABORATION &amp; TEAM CHANNELS" Style="{StaticResource FormFieldLabel}"/>

                <!-- Channel 1: Microsoft Teams -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="32" Height="32" Background="#464EB8" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="T" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Microsoft Teams Webhook" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                    <Border Background="#EEF2FF" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                        <TextBlock Text="MessageCard &amp; Adaptive Card" FontSize="9.5" FontWeight="Bold" Foreground="#4F46E5"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Delivers rich Teams cards with status bands, activity facts, and certificate metadata." FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Content="Enabled" IsChecked="{Binding TeamsEnabled}" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,10,0" Cursor="Hand"/>
                                <Button Command="{Binding TestTeamsCommand}" Content="Send Test" Padding="8,4" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Teams Webhook URL:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding TeamsWebhookUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Channel 2: Discord -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="32" Height="32" Background="#5865F2" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="D" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Discord Channel Webhook" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                    <Border Background="#EEF2FF" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                        <TextBlock Text="Rich Embeds" FontSize="9.5" FontWeight="Bold" Foreground="#5865F2"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Delivers color-coded embeds with timestamps to any Discord text channel." FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Content="Enabled" IsChecked="{Binding DiscordEnabled}" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,10,0" Cursor="Hand"/>
                                <Button Command="{Binding TestDiscordCommand}" Content="Send Test" Padding="8,4" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Discord Webhook URL:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding DiscordWebhookUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Channel 3: Slack -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="32" Height="32" Background="#4A154B" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="S" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Slack Incoming Webhook" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                    <Border Background="#FDF2F8" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                        <TextBlock Text="Attachments &amp; Colors" FontSize="9.5" FontWeight="Bold" Foreground="#DB2777"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Delivers formatted Slack message attachments with color status bars." FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Content="Enabled" IsChecked="{Binding SlackEnabled}" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,10,0" Cursor="Hand"/>
                                <Button Command="{Binding TestSlackCommand}" Content="Send Test" Padding="8,4" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Slack Webhook URL:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding SlackWebhookUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Channel 4: Telegram -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="32" Height="32" Background="#229ED9" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="TG" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Telegram Bot Alerts" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                    <Border Background="#F0F9FF" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                        <TextBlock Text="Direct Bot API" FontSize="9.5" FontWeight="Bold" Foreground="#0284C7"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Delivers instant markdown alerts to your personal Telegram chat or private DevOps channel." FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Content="Enabled" IsChecked="{Binding TelegramEnabled}" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,10,0" Cursor="Hand"/>
                                <Button Command="{Binding TestTelegramCommand}" Content="Send Test" Padding="8,4" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Telegram Bot Token:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding TelegramBotToken, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Chat ID / Channel ID:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding TelegramChatId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- SECTION 3: Mobile Push & Self-Hosted Sources -->
                <TextBlock Text="MOBILE PUSH &amp; ADVANCED INTEGRATIONS" Style="{StaticResource FormFieldLabel}" Margin="0,10,0,8"/>

                <!-- Channel 5: Pushover Mobile Push -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="32" Height="32" Background="#2F80ED" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="P" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Pushover (Mobile Push Alerts)" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                    <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                        <TextBlock Text="iOS / Android" FontSize="9.5" FontWeight="Bold" Foreground="#2563EB"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Instant push notifications directly to smartphones and Apple Watch with emergency bypass." FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Content="Enabled" IsChecked="{Binding PushoverEnabled}" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,10,0" Cursor="Hand"/>
                                <Button Command="{Binding TestPushoverCommand}" Content="Send Test" Padding="8,4" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Application API Token:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding PushoverAppToken, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="User / Group Key:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding PushoverUserKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Channel 6: Gotify Self-Hosted Push -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="32" Height="32" Background="#10B981" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="G" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Gotify (Self-Hosted Push)" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                    <Border Background="#ECFDF5" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                        <TextBlock Text="On-Premises / Homelab" FontSize="9.5" FontWeight="Bold" Foreground="#059669"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Private self-hosted push notifications running inside Docker, Kubernetes, or internal network." FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Content="Enabled" IsChecked="{Binding GotifyEnabled}" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,10,0" Cursor="Hand"/>
                                <Button Command="{Binding TestGotifyCommand}" Content="Send Test" Padding="8,4" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Gotify Server URL (e.g. https://gotify.domain.local):" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding GotifyServerUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="App Token (Client Key):" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding GotifyAppToken, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Channel 7: Generic Custom Webhook -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="32" Height="32" Background="#64748B" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="API" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Custom HTTP Webhook" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                        <TextBlock Text="JSON POST" FontSize="9.5" FontWeight="Bold" Foreground="#475569"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Universal structured JSON payload for Zapier, n8n, Make, Datadog, or custom REST webhooks." FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Content="Enabled" IsChecked="{Binding GenericWebhookEnabled}" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,10,0" Cursor="Hand"/>
                                <Button Command="{Binding TestGenericWebhookCommand}" Content="Send Test" Padding="8,4" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Target Endpoint URL:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding GenericWebhookUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Channel 8: Email / SMTP -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="32" Height="32" Background="#EA580C" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="@" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Email / SMTP Relay" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                    <Border Background="#FFF7ED" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                        <TextBlock Text="RFC 5322" FontSize="9.5" FontWeight="Bold" Foreground="#EA580C"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Standard email alert relay through company mail server or external SMTP provider." FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Content="Enabled" IsChecked="{Binding SmtpEnabled}" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,10,0" Cursor="Hand"/>
                                <Button Command="{Binding TestSmtpCommand}" Content="Send Test" Padding="8,4" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                <TextBlock Text="SMTP Host:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SmtpHost, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,8">
                                <TextBlock Text="Port:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SmtpPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8" VerticalAlignment="Center">
                                <CheckBox Content="Enable SSL/TLS" IsChecked="{Binding SmtpEnableSsl}" FontWeight="SemiBold" Foreground="#475569" Margin="0,18,0,0" Cursor="Hand"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="From Address:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SmtpFromAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,0">
                                <TextBlock Text="Recipient Address (To):" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SmtpToAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Bottom Save Action Strip -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Ready to persist configuration across background service and desktop UI?" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock Text="Settings apply immediately to the 24/7 autonomous renewal engine." FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding SaveSettingsCommand}" Style="{StaticResource ModernPrimaryActionBtn}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSave}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Save Alert Settings"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

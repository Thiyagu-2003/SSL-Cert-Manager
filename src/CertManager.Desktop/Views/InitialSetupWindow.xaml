<Window x:Class="CertManager.Desktop.Views.InitialSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Welcome to CertFlow — Global Account Configuration" 
        Icon="../Assets/certflow.ico"
        Height="570" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        Background="#F8FAFC">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0284C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28,26,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0284C7" CornerRadius="12" Width="46" Height="46" Margin="0,0,14,0">
                <Path Data="{StaticResource IconShieldCheck}" Fill="#FFFFFF" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Global Contact Configuration" FontSize="19" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Set your official Let's Encrypt administrator email once for all websites" 
                           FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Body Form -->
        <StackPanel Grid.Row="1">
            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconInfo}" Fill="#1E40AF" Width="14" Height="14" Stretch="Uniform" Margin="0,2,8,0" VerticalAlignment="Top"/>
                    <TextBlock Text="Let's Encrypt requires a valid contact email for ACME account registration. It is used exclusively to send critical certificate expiry warnings and security notices. It will be applied globally across all your IIS sites."
                               FontSize="11.5" Foreground="#1E40AF" TextWrapping="Wrap" Width="430"/>
                </StackPanel>
            </Border>

            <!-- Contact Email Field -->
            <TextBlock Text="GLOBAL CONTACT EMAIL ADDRESS" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
            <TextBox Text="{Binding ContactEmail, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

            <!-- Default Environment -->
            <TextBlock Text="PREFERRED ENVIRONMENT DEFAULT" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                <StackPanel>
                    <RadioButton Content="Let's Encrypt Production (Official live public certificates)" 
                                 GroupName="InitialEnv"
                                 IsChecked="{Binding IsProduction}" FontWeight="Medium" Foreground="#1E293B" Margin="0,0,0,8" Cursor="Hand"/>
                    <RadioButton Content="Let's Encrypt Staging (Recommended for safe initial testing)" 
                                 GroupName="InitialEnv"
                                 IsChecked="{Binding IsStaging}" FontWeight="Medium" Foreground="#1E293B" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- Optional Notification Webhook -->
            <TextBlock Text="TEAM NOTIFICATION WEBHOOK (DISCORD, SLACK, TEAMS — OPTIONAL)" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
            <TextBox Text="{Binding WebhookUrl, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>

            <!-- Error Banner -->
            <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="11.5" FontWeight="Medium" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Bottom Action Buttons -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Content="Skip for Now" Click="OnSkipClicked"
                    Background="Transparent" BorderThickness="0" Foreground="#64748B" 
                    Padding="14,10" Cursor="Hand" Margin="0,0,10,0" FontWeight="Medium"/>

            <Button Grid.Column="2" Command="{Binding SaveCommand}" 
                    Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" 
                    Padding="22,10" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconCheck}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Save &amp; Continue" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
